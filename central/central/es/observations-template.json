{
  "index_patterns": ["devicedb-obs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "obs_id":       { "type": "long" },
        "contributor":  { "type": "keyword" },
        "signal":       { "type": "keyword" },
        "observed_at":  { "type": "date" },
        "received_at":  { "type": "date" },
        "mac_hash":     { "type": "keyword" },
        "device_id":    { "type": "keyword" },
        "model_id":     { "type": "keyword" },
        "vendor":       { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "device_class": { "type": "keyword" },
        "name":         { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "rssi":         { "type": "integer" },
        "channel":      { "type": "keyword" },
        "fingerprint":  { "type": "keyword" },
        "place":        { "type": "keyword" },
        "location":     { "type": "geo_point" },
        "extra":        { "type": "flattened" }
      }
    }
  }
}
