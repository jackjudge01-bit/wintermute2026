{
  "index_patterns": ["devicedb-models-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "model_id":     { "type": "keyword" },
        "vendor":       { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "model_name":   { "type": "keyword", "fields": { "text": { "type": "text" } } },
        "device_class": { "type": "keyword" },
        "capabilities": { "type": "flattened" },
        "confidence":   { "type": "float" },
        "sources":      { "type": "keyword" },
        "created_at":   { "type": "date" },
        "updated_at":   { "type": "date" }
      }
    }
  }
}
